---
import Base from '../layouts/Base.astro';
import { type Lang } from '../i18n/index';
import { pt } from '../i18n/pt';
import { en } from '../i18n/en';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = (lang === 'pt' ? pt : en).faq;
---

<Base lang={lang} page="faq" title={t.title} description={t.description}>
  <div class="wrap">
    <section class="block">
      <h1>{t.h1}</h1>
      <div class="faq-list" style="margin-top: 1.5rem;">
        {t.items.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <div class="answer"><p>{item.a}</p></div>
          </details>
        ))}
      </div>
      <hr class="divider" />
    </section>
  </div>
</Base>
