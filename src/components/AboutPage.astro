---
import Base from '../layouts/Base.astro';
import { pagePath, type Lang } from '../i18n/index';
import { pt } from '../i18n/pt';
import { en } from '../i18n/en';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = (lang === 'pt' ? pt : en).about;
---

<Base lang={lang} page="about" title={t.title} description={t.description}>
  <div class="wrap">
    <section class="block">
      <h1>{t.h1}</h1>
      <div class="prose">
        <p class="lead">{t.aboutText}</p>
      </div>
    </section>

    <section class="block" aria-labelledby="form-h">
      <h2 id="form-h">{t.formTitle}</h2>
      <div class="card form-card">
        <form id="beta-form" data-lang={lang}>
          <div class="field">
            <label for="beta-name">{t.formName}</label>
            <input id="beta-name" name="name" type="text" maxlength="80" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="beta-email">{t.formEmail}</label>
            <input id="beta-email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="field">
            <label for="beta-platform">{t.formPlatform}</label>
            <select id="beta-platform" name="platform" required>
              <option value="">{t.formPlatformPlaceholder}</option>
              {t.formPlatformOptions.map((o) => (
                <option value={o.value}>{o.label}</option>
              ))}
            </select>
          </div>
          <div class="field">
            <label for="beta-occupation">{t.formOccupation}</label>
            <select id="beta-occupation" name="occupation">
              <option value="">{t.formSelectPlaceholder}</option>
              {t.formOccupationOptions.map((o) => (
                <option>{o}</option>
              ))}
            </select>
          </div>
          <div class="field">
            <label for="beta-games">{t.formGames}</label>
            <input id="beta-games" name="games" type="text" maxlength="300" />
          </div>
          <div class="field">
            <label for="beta-referral">{t.formReferral}</label>
            <select id="beta-referral" name="referral">
              <option value="">{t.formSelectPlaceholder}</option>
              {t.formReferralOptions.map((o) => (
                <option>{o}</option>
              ))}
            </select>
          </div>
          <div class="field field--check">
            <label><input type="checkbox" name="updates" /> {t.formUpdates}</label>
          </div>
          <div class="field field--check">
            <label><input type="checkbox" name="privacy" required /> {t.formPrivacy} <a href={pagePath('privacy', lang)}>{t.formPrivacyLink}</a></label>
          </div>
          <input
            type="text"
            name="website"
            class="honeypot"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />
          <button class="btn" type="submit">{t.formSubmit}</button>
          <p id="beta-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>

    <section class="block" aria-labelledby="contact-h">
      <h2 id="contact-h">{t.contactTitle}</h2>
      <p>{t.contactText}</p>
      <p>
        <a class="btn" href={`mailto:${t.contactEmail}?subject=${encodeURIComponent(t.contactSubject)}`}>{t.contactCta}</a>
      </p>
      <p style="font-size: 0.9rem; color: var(--muted);">{t.contactEmail}</p>
      <hr class="divider" />
    </section>
  </div>
</Base>

<script define:vars={{ MSG: t.formMsg }}>
  const form = document.getElementById('beta-form');
  const statusEl = document.getElementById('beta-status');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = new FormData(form);
    const body = {
      name: f.get('name'), email: f.get('email'), platform: f.get('platform'),
      occupation: f.get('occupation') || '', games: f.get('games') || '',
      referral: f.get('referral') || '', updates: f.get('updates') === 'on',
      privacy: f.get('privacy') === 'on', language: form.dataset.lang,
      website: f.get('website') || '',
    };
    const button = form.querySelector('button[type=submit]');
    button.disabled = true;
    try {
      const r = await fetch('https://api.parcaplay.com/v1/signup', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const data = await r.json().catch(() => ({}));
      if (r.ok) { statusEl.textContent = (MSG[data.status] || MSG.queued).replace('{email}', String(body.email || '')); if (data.status !== 'exists') form.reset(); }
      else if (r.status === 429) statusEl.textContent = MSG.rate;
      else statusEl.textContent = MSG['field_' + (data.detail?.field || 'other')] || MSG.error;
    } catch { statusEl.textContent = MSG.network; }
    finally { button.disabled = false; }
  });
</script>
